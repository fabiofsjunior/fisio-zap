# Supabase — configure somente no ambiente local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # somente scripts/backend local; nunca NEXT_PUBLIC_

# Desenvolvimento local
# npm run dev escolhe automaticamente duas portas livres entre 3000 e 4000.
NEXT_PUBLIC_BACKEND_URL= # preenchido pelo launcher
FRONTEND_ORIGIN= # preenchido pelo launcher

# Contas de teste: defina credenciais exclusivas para seu ambiente local.
# Não reutilize senhas de produção nem publique credenciais reais.
FISIOZAP_ADMIN_EMAIL=admin@fisiozap.local
FISIOZAP_ADMIN_PASSWORD=
FISIOZAP_TEST_EMAIL=teste@fisiozap.local
FISIOZAP_TEST_PASSWORD=
FISIOZAP_TEST_ORG=FisioZap — Ambiente de Teste

# AI - configure only locally
AI_API_KEY=

# S7.4 — transcrição opcional, somente backend; desativada por padrão.
# Habilitar implica enviar áudio ao OpenAI após confirmação na interface.
# A API do provedor tem cobrança própria; não use dados clínicos na homologação.
FISIOZAP_TRANSCRIPTION_ENABLED=false
OPENAI_API_KEY=
FISIOZAP_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# WhatsApp/Baileys - local backend only
WHATSAPP_SESSION_PATH=./.data/whatsapp
